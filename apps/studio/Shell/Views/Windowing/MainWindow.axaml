<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Editor.Shell.ViewModels.Windowing"
        xmlns:scenes="using:Asharia.Studio.Application.Scenes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        x:Class="Editor.Shell.Views.Windowing.MainWindow"
        x:DataType="vm:StudioShellViewModel"
        AutomationProperties.AutomationId="StudioShellWindow"
        AutomationProperties.Name="Asharia Studio"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="#0B0F14"
        Foreground="#E6EDF3">
    <Grid Margin="20">
        <Border x:Name="StartingState"
                AutomationProperties.AutomationId="StudioShellStartingState"
                AutomationProperties.Name="Studio startup state"
                AutomationProperties.ControlTypeOverride="StatusBar"
                IsVisible="{Binding IsStarting}"
                MaxWidth="720"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#10161D"
                BorderBrush="#1F2933"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Spacing="12">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Text="Asharia Studio" />
                <TextBlock x:Name="StartingStateText"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="18"
                           Text="{Binding StartingStateText}" />
            </StackPanel>
        </Border>

        <Grid x:Name="WorkspaceState"
              IsVisible="{Binding IsWorkspaceVisible}">
            <Grid x:Name="EmptyWorkspace"
                  IsVisible="{Binding HasNoProject}"
                  MaxWidth="920"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="16">
                <Border x:Name="NoProjectState"
                        AutomationProperties.AutomationId="StudioShellNoProjectState"
                        AutomationProperties.Name="Project state: No Project"
                        AutomationProperties.ControlTypeOverride="Group"
                        IsVisible="{Binding HasNoProject}"
                        Padding="22"
                        Background="#10161D"
                        BorderBrush="#1F2933"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="NoProjectStateText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProjectStateText}" />
                        <TextBlock Foreground="#9BA7B4"
                                   TextWrapping="Wrap"
                                   Text="Create a project to generate its canonical descriptor and default editable scene, or open an existing asharia.project.json." />
                        <TextBox x:Name="NewProjectNameTextBox"
                                 AutomationProperties.Name="New project name"
                                 Text="{Binding NewProjectName}"
                                 PlaceholderText="Project name" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CreateProjectButton"
                                    AutomationProperties.Name="Create project"
                                    Command="{Binding CreateProjectCommand}"
                                    Content="Create Project" />
                            <Button x:Name="OpenProjectButton"
                                    AutomationProperties.Name="Open project"
                                    Command="{Binding OpenProjectCommand}"
                                    Content="Open Project" />
                        </StackPanel>
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="#9BA7B4"
                                   Text="{Binding ProjectOperationStateText}" />
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="#E5B567"
                                   IsVisible="{Binding HasProjectOperationMessage}"
                                   TextWrapping="Wrap"
                                   Text="{Binding ProjectOperationMessage}" />
                    </StackPanel>
                </Border>

                <Border x:Name="NoDocumentState"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="StudioShellNoDocumentState"
                        AutomationProperties.Name="Document state: No Document"
                        AutomationProperties.ControlTypeOverride="Group"
                        IsVisible="{Binding HasNoProject}"
                        Padding="22"
                        Background="#10161D"
                        BorderBrush="#1F2933"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="NoDocumentStateText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding DocumentStateText}" />
                        <TextBlock Foreground="#9BA7B4"
                                   TextWrapping="Wrap"
                                   Text="A SceneDocument is opened automatically after project validation succeeds." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ActiveProjectState"
                  AutomationProperties.AutomationId="StudioShellActiveProjectState"
                  AutomationProperties.Name="Editable scene workspace"
                  AutomationProperties.ControlTypeOverride="Group"
                  IsVisible="{Binding HasProject}"
                  RowDefinitions="Auto,*"
                  RowSpacing="12">
                <Border Padding="12"
                        Background="#10161D"
                        BorderBrush="#1F2933"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                        <Button x:Name="CreateEntityButton"
                                Grid.Column="0"
                                AutomationProperties.Name="Create entity"
                                Command="{Binding CreateEntityCommand}"
                                Content="+ Entity" />
                        <Button x:Name="SaveSceneButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Save scene"
                                Command="{Binding SaveSceneCommand}"
                                Content="Save" />
                        <Button Grid.Column="2"
                                AutomationProperties.Name="Open another project"
                                Command="{Binding OpenProjectCommand}"
                                Content="Open Another" />
                        <Button Grid.Column="3"
                                AutomationProperties.Name="Close project"
                                Command="{Binding CloseProjectCommand}"
                                Content="Close" />
                        <StackPanel Grid.Column="4" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding ProjectStateText}" />
                            <TextBlock FontSize="11" Foreground="#9BA7B4" Text="{Binding ProjectPathText}" />
                        </StackPanel>
                        <TextBlock Grid.Column="5"
                                   VerticalAlignment="Center"
                                   Foreground="#9BA7B4"
                                   Text="{Binding DocumentStateText}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      ColumnDefinitions="240,*,320"
                      ColumnSpacing="12">
                    <Border x:Name="HierarchyPanel"
                            AutomationProperties.AutomationId="StudioHierarchyPanel"
                            AutomationProperties.Name="Scene Hierarchy"
                            AutomationProperties.ControlTypeOverride="Group"
                            Padding="12"
                            Background="#10161D"
                            BorderBrush="#1F2933"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Hierarchy" />
                            <ListBox x:Name="HierarchyList"
                                     Grid.Row="1"
                                     ItemsSource="{Binding SceneEntities}"
                                     SelectedItem="{Binding SelectedEntity}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="scenes:SceneEntitySnapshot">
                                        <TextBlock Padding="6" Text="{Binding Name}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="20"
                            Background="#0F141B"
                            BorderBrush="#1F2933"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="SceneDocument" />
                            <TextBlock Foreground="#9BA7B4"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{Binding DocumentPathText}" />
                            <TextBlock Foreground="#9BA7B4"
                                       Text="The authoritative EditWorld is owned behind EngineBridge." />
                            <TextBlock Foreground="#E5B567"
                                       IsVisible="{Binding HasProjectOperationMessage}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{Binding ProjectOperationMessage}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="InspectorPanel"
                            Grid.Column="2"
                            AutomationProperties.AutomationId="StudioInspectorPanel"
                            AutomationProperties.Name="Entity Inspector"
                            AutomationProperties.ControlTypeOverride="Group"
                            Padding="12"
                            Background="#10161D"
                            BorderBrush="#1F2933"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <TextBlock IsVisible="{Binding !HasSelection}"
                                       Foreground="#9BA7B4"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="Select an entity" />
                            <ScrollViewer IsVisible="{Binding HasSelection}">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Inspector" />
                                    <TextBlock Foreground="#9BA7B4" Text="Name" />
                                    <TextBox Text="{Binding InspectorName}" />
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding ApplyEntityNameCommand}"
                                            Content="Apply Name" />
                                    <TextBlock Margin="0,8,0,0"
                                               FontWeight="SemiBold"
                                               Text="Transform" />
                                    <TextBlock Foreground="#9BA7B4" Text="Position (X / Y / Z)" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <TextBox Grid.Column="0" Text="{Binding PositionX}" />
                                        <TextBox Grid.Column="1" Text="{Binding PositionY}" />
                                        <TextBox Grid.Column="2" Text="{Binding PositionZ}" />
                                    </Grid>
                                    <TextBlock Foreground="#9BA7B4" Text="Rotation (X / Y / Z / W)" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                        <TextBox Grid.Column="0" Text="{Binding RotationX}" />
                                        <TextBox Grid.Column="1" Text="{Binding RotationY}" />
                                        <TextBox Grid.Column="2" Text="{Binding RotationZ}" />
                                        <TextBox Grid.Column="3" Text="{Binding RotationW}" />
                                    </Grid>
                                    <TextBlock Foreground="#9BA7B4" Text="Scale (X / Y / Z)" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <TextBox Grid.Column="0" Text="{Binding ScaleX}" />
                                        <TextBox Grid.Column="1" Text="{Binding ScaleY}" />
                                        <TextBox Grid.Column="2" Text="{Binding ScaleZ}" />
                                    </Grid>
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding ApplyEntityTransformCommand}"
                                            Content="Apply Transform" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
