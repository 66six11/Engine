<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Editor.Shell.ViewModels.Windowing"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="600"
        x:Class="Editor.Shell.Views.Windowing.MainWindow"
        x:DataType="vm:StudioShellViewModel"
        AutomationProperties.AutomationId="StudioShellWindow"
        AutomationProperties.Name="Asharia Studio"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="960"
        Height="600"
        MinWidth="640"
        MinHeight="400"
        Background="#0B0F14"
        Foreground="#E6EDF3">
    <Grid Margin="48">
        <StackPanel MaxWidth="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24">
            <TextBlock AutomationProperties.AccessibilityView="Content"
                       AutomationProperties.HeadingLevel="1"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="Asharia Studio" />

            <Border x:Name="StartingState"
                    AutomationProperties.AutomationId="StudioShellStartingState"
                    AutomationProperties.Name="Studio startup state"
                    AutomationProperties.ControlTypeOverride="StatusBar"
                    IsVisible="{Binding IsStarting}"
                    Padding="18"
                    Background="#10161D"
                    BorderBrush="#1F2933"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBlock x:Name="StartingStateText"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="18"
                           Text="{Binding StartingStateText}" />
            </Border>

            <Grid x:Name="WorkspaceState"
                  IsVisible="{Binding IsWorkspaceVisible}"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="16">
                <Border x:Name="NoProjectState"
                        AutomationProperties.AutomationId="StudioShellNoProjectState"
                        AutomationProperties.Name="Project state: No Project"
                        AutomationProperties.ControlTypeOverride="Group"
                        Padding="18"
                        Background="#10161D"
                        BorderBrush="#1F2933"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsVisible="{Binding HasNoProject}">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="NoProjectStateText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProjectStateText}" />
                        <TextBlock Foreground="#9BA7B4"
                                   TextWrapping="Wrap"
                                   Text="Create a canonical project or open an existing asharia.project.json descriptor." />
                        <TextBox x:Name="NewProjectNameTextBox"
                                 AutomationProperties.Name="New project name"
                                 Text="{Binding NewProjectName}"
                                 PlaceholderText="Project name" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Name="CreateProjectButton"
                                    AutomationProperties.Name="Create project"
                                    Command="{Binding CreateProjectCommand}"
                                    Content="Create Project" />
                            <Button x:Name="OpenProjectButton"
                                    AutomationProperties.Name="Open project"
                                    Command="{Binding OpenProjectCommand}"
                                    Content="Open Project" />
                        </StackPanel>
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="#9BA7B4"
                                   Text="{Binding ProjectOperationStateText}" />
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="#E5B567"
                                   IsVisible="{Binding HasProjectOperationMessage}"
                                   TextWrapping="Wrap"
                                   Text="{Binding ProjectOperationMessage}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ActiveProjectState"
                        AutomationProperties.AutomationId="StudioShellActiveProjectState"
                        AutomationProperties.Name="Active project state"
                        AutomationProperties.ControlTypeOverride="Group"
                        Padding="18"
                        Background="#10161D"
                        BorderBrush="#1F2933"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsVisible="{Binding HasProject}">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProjectStateText}" />
                        <TextBlock Foreground="#9BA7B4"
                                   TextWrapping="Wrap"
                                   Text="{Binding ProjectPathText}" />
                        <Button AutomationProperties.Name="Open another project"
                                HorizontalAlignment="Left"
                                Command="{Binding OpenProjectCommand}"
                                Content="Open Another Project" />
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="#E5B567"
                                   IsVisible="{Binding HasProjectOperationMessage}"
                                   TextWrapping="Wrap"
                                   Text="{Binding ProjectOperationMessage}" />
                    </StackPanel>
                </Border>

                <Border x:Name="NoDocumentState"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="StudioShellNoDocumentState"
                        AutomationProperties.Name="Document state: No Document"
                        AutomationProperties.ControlTypeOverride="Group"
                        Padding="18"
                        Background="#10161D"
                        BorderBrush="#1F2933"
                        BorderThickness="1"
                        CornerRadius="6">
                    <TextBlock x:Name="NoDocumentStateText"
                               FontSize="18"
                               Text="{Binding DocumentStateText}" />
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
