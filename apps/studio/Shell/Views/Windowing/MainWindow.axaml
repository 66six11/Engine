<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Editor.Shell.ViewModels.Windowing"
        xmlns:dockViews="using:Editor.Shell.Views.Docking"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        x:Class="Editor.Shell.Views.Windowing.MainWindow"
        x:DataType="vm:StudioShellViewModel"
        AutomationProperties.AutomationId="StudioShellWindow"
        AutomationProperties.Name="Asharia Studio"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Background="{DynamicResource EditorBrushBase00}"
        Foreground="{DynamicResource EditorBrushTextPrimary}">
    <Grid>
        <Border x:Name="StartingState"
                AutomationProperties.AutomationId="StudioShellStartingState"
                AutomationProperties.Name="Studio startup state"
                AutomationProperties.ControlTypeOverride="StatusBar"
                IsVisible="{Binding IsStarting}"
                MaxWidth="720"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource EditorBrushSurface01}"
                BorderBrush="{DynamicResource EditorBrushDivider}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Spacing="12">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Asharia Studio" />
                <TextBlock x:Name="StartingStateText"
                           AutomationProperties.LiveSetting="Polite"
                           FontSize="18"
                           Text="{Binding StartingStateText}" />
            </StackPanel>
        </Border>

        <Grid x:Name="WorkspaceState" IsVisible="{Binding IsWorkspaceVisible}">
            <Grid x:Name="EmptyWorkspace"
                  IsVisible="{Binding HasNoProject}"
                  Margin="20"
                  MaxWidth="920"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="16">
                <Border x:Name="NoProjectState"
                        AutomationProperties.AutomationId="StudioShellNoProjectState"
                        AutomationProperties.Name="Project state: No Project"
                        AutomationProperties.ControlTypeOverride="Group"
                        IsVisible="{Binding HasNoProject}"
                        Padding="22"
                        Background="{DynamicResource EditorBrushSurface01}"
                        BorderBrush="{DynamicResource EditorBrushDivider}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="NoProjectStateText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProjectStateText}" />
                        <TextBlock Foreground="{DynamicResource EditorBrushTextMuted}"
                                   TextWrapping="Wrap"
                                   Text="Create a project to generate its canonical descriptor and default editable scene, or open an existing asharia.project.json." />
                        <TextBox x:Name="NewProjectNameTextBox"
                                 AutomationProperties.Name="New project name"
                                 Text="{Binding NewProjectName}"
                                 PlaceholderText="Project name" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CreateProjectButton"
                                    AutomationProperties.Name="Create project"
                                    Command="{Binding CreateProjectCommand}"
                                    Content="Create Project" />
                            <Button x:Name="OpenProjectButton"
                                    AutomationProperties.Name="Open project"
                                    Command="{Binding OpenProjectCommand}"
                                    Content="Open Project" />
                        </StackPanel>
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource EditorBrushTextMuted}"
                                   Text="{Binding ProjectOperationStateText}" />
                        <TextBlock AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource EditorBrushWarning}"
                                   IsVisible="{Binding HasProjectOperationMessage}"
                                   TextWrapping="Wrap"
                                   Text="{Binding ProjectOperationMessage}" />
                    </StackPanel>
                </Border>

                <Border x:Name="NoDocumentState"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="StudioShellNoDocumentState"
                        AutomationProperties.Name="Document state: No Document"
                        AutomationProperties.ControlTypeOverride="Group"
                        IsVisible="{Binding HasNoProject}"
                        Padding="22"
                        Background="{DynamicResource EditorBrushSurface01}"
                        BorderBrush="{DynamicResource EditorBrushDivider}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="NoDocumentStateText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding DocumentStateText}" />
                        <TextBlock Foreground="{DynamicResource EditorBrushTextMuted}"
                                   TextWrapping="Wrap"
                                   Text="A SceneDocument is opened automatically after project validation succeeds." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ActiveProjectState"
                  AutomationProperties.AutomationId="StudioShellActiveProjectState"
                  AutomationProperties.Name="Editable docked scene workspace"
                  AutomationProperties.ControlTypeOverride="Group"
                  IsVisible="{Binding HasProject}"
                  RowDefinitions="Auto,*">
                <Border Padding="6,4"
                        Background="{DynamicResource EditorBrushBase01}"
                        BorderBrush="{DynamicResource EditorBrushDivider}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
                        <Button x:Name="CreateEntityButton"
                                AutomationProperties.Name="Create entity"
                                Command="{Binding CreateEntityCommand}"
                                Content="+ Entity" />
                        <Button x:Name="CreateMeshEntityButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Create validation mesh entity"
                                Command="{Binding CreateMeshEntityCommand}"
                                Content="+ Mesh" />
                        <Button x:Name="SaveSceneButton"
                                Grid.Column="2"
                                AutomationProperties.Name="Save scene"
                                Command="{Binding SaveSceneCommand}"
                                Content="Save" />
                        <Button x:Name="UndoSceneButton"
                                Grid.Column="3"
                                AutomationProperties.Name="{Binding UndoSceneLabel}"
                                Command="{Binding UndoSceneCommand}"
                                Content="{Binding UndoSceneLabel}"
                                ToolTip.Tip="Ctrl/Cmd+Z" />
                        <Button x:Name="RedoSceneButton"
                                Grid.Column="4"
                                AutomationProperties.Name="{Binding RedoSceneLabel}"
                                Command="{Binding RedoSceneCommand}"
                                Content="{Binding RedoSceneLabel}"
                                ToolTip.Tip="Ctrl/Cmd+Y · Ctrl/Cmd+Shift+Z" />
                        <Button Grid.Column="5"
                                AutomationProperties.Name="Open another project"
                                Command="{Binding OpenProjectCommand}"
                                Content="Open" />
                        <Button Grid.Column="6"
                                AutomationProperties.Name="Close project"
                                Command="{Binding CloseProjectCommand}"
                                Content="Close" />
                        <TextBlock Grid.Column="7"
                                   Margin="10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding ProjectStateText}" />
                        <TextBlock x:Name="DocumentStateText"
                                   Grid.Column="8"
                                   AutomationProperties.AutomationId="StudioDocumentState"
                                   AutomationProperties.Name="{Binding DocumentStateText}"
                                   AutomationProperties.ControlTypeOverride="StatusBar"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource EditorBrushTextMuted}"
                                   Text="{Binding DocumentStateText}" />
                    </Grid>
                </Border>

                <dockViews:EditorDockWorkspaceView Grid.Row="1"
                                                   DataContext="{Binding DockWorkspace}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
