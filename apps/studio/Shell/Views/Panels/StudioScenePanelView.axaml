<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="using:Asharia.Studio.Presentation.Avalonia.Viewports"
             xmlns:vm="using:Editor.Shell.ViewModels.Panels"
             x:Class="Editor.Shell.Views.Panels.StudioScenePanelView"
             x:DataType="vm:StudioScenePanelViewModel"
             AutomationProperties.AutomationId="StudioSceneDocumentPanel"
             AutomationProperties.Name="Scene Document"
             AutomationProperties.ControlTypeOverride="Group">
    <Grid Background="{DynamicResource EditorBrushBase00}">
        <presentation:ViewportCompositionControl
            x:Name="SceneViewport"
            Session="{Binding Session}"
            RevisionToken="{Binding ViewportRevision}"
            Lifetime="{Binding PresentationLifetime}" />

        <Border Margin="12"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource EditorBrushBase10}"
                CornerRadius="4"
                IsVisible="{Binding #SceneViewport.IsDegraded}">
            <StackPanel MaxWidth="520" Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Scene View unavailable" />
                <TextBlock Foreground="{DynamicResource EditorBrushWarning}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding #SceneViewport.StatusMessage}" />
                <TextBlock Foreground="{DynamicResource EditorBrushTextMuted}"
                           TextAlignment="Center"
                           Text="Hierarchy, Inspector and Save remain available." />
            </StackPanel>
        </Border>

        <Border Margin="8"
                Padding="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#B0181A1F"
                CornerRadius="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.Name="Create entity"
                        Command="{Binding Shell.CreateEntityCommand}"
                        Content="+ Entity" />
                <Button AutomationProperties.Name="Save scene"
                        Command="{Binding Shell.SaveSceneCommand}"
                        Content="Save" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource EditorBrushTextMuted}"
                           Text="{Binding Shell.DocumentStateText}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
