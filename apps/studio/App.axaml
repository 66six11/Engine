<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockVm="using:Editor.Shell.ViewModels.Docking"
             xmlns:dockViews="using:Editor.Shell.Views.Docking"
             xmlns:panelVm="using:Editor.Shell.ViewModels.Panels"
             xmlns:panelViews="using:Editor.Shell.Views.Panels"
             x:Class="Editor.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type dockVm:EditorDockSplitNodeViewModel}">
            <dockViews:EditorDockSplitNodeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dockVm:EditorDockWindowNodeViewModel}">
            <dockViews:EditorDockWindowNodeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type panelVm:StudioHierarchyPanelViewModel}">
            <panelViews:StudioHierarchyPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type panelVm:StudioScenePanelViewModel}">
            <panelViews:StudioScenePanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type panelVm:StudioInspectorPanelViewModel}">
            <panelViews:StudioInspectorPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type panelVm:StudioProjectPanelViewModel}">
            <panelViews:StudioProjectPanelView />
        </DataTemplate>
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Editor/UI/Styles/Tokens/DeepDarkColors.axaml" />
                <ResourceInclude Source="avares://Editor/UI/Styles/Tokens/EditorMetrics.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
    </Application.Styles>
</Application>
