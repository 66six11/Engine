<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Editor.Features.SceneView.ViewModels"
             xmlns:views="using:Editor.Features.SceneView.Views"
             x:Class="Editor.Features.SceneView.Views.SceneViewPanelView"
             x:DataType="vm:SceneViewPanelViewModel">
    <Grid Background="{DynamicResource EditorBrushBase00}">
        <views:SceneViewCompositionHost x:Name="CompositionHost"
                                        ClipToBounds="True"
                                        Focusable="True" />
    </Grid>
</UserControl>
